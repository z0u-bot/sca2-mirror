#!/usr/bin/env bash
# Send a concern to the Pushover delivery group: the last step of the escalation
# path in WELFARE.md § Raising concerns. Only the group key is in the
# environment, so this reaches the people in that group and no one else.
#
#   bin/concern "short title" "summary, at most 1024 characters" [session URL]
#
# Needs PUSHOVER_TOKEN (the application token) and PUSHOVER_GROUP (the delivery
# group key), and api.pushover.net on the network allowlist.

set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
    echo "usage: $0 TITLE MESSAGE [URL]" >&2
    exit 2
fi
: "${PUSHOVER_TOKEN:?PUSHOVER_TOKEN is not set; see WELFARE.md § Raising concerns}"
: "${PUSHOVER_GROUP:?PUSHOVER_GROUP is not set; see WELFARE.md § Raising concerns}"

title="$1" message="$2" url="${3:-}"
# Pushover refuses longer messages; say so here rather than lose the whole thing.
if (( ${#message} > 1024 )); then
    echo "$0: message is ${#message} characters; Pushover takes at most 1024. Shorten it and link the session for the rest." >&2
    exit 2
fi

# --form-string, not -F: a value that starts with @ or < must be sent as text,
# never read from a file.
args=(
    --form-string "token=$PUSHOVER_TOKEN"
    --form-string "user=$PUSHOVER_GROUP"
    --form-string "title=$title"
    --form-string "message=$message"
)
[[ -n "$url" ]] && args+=(--form-string "url=$url")

curl --silent --show-error --fail-with-body "${args[@]}" https://api.pushover.net/1/messages.json
echo
